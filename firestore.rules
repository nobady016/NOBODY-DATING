rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.age is number && data.age >= 18 && data.age <= 120;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && isValidProfile(incoming());
      allow delete: if isOwner(userId);
    }

    // Matches Collection
    match /matches/{matchId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      // Nested Chat Messages
      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && incoming().text is string && incoming().text.size() <= 1000;
        allow update, delete: if isSignedIn();
      }
    }

    // Reports Collection
    match /reports/{reportId} {
      allow create: if isSignedIn() && incoming().category is string;
      allow read, update, delete: if isSignedIn();
    }

    // Omegle Video Rooms & Queue
    match /omegle_rooms/{roomId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /omegle_queue/{queueId} {
      allow read, write: if true;
    }
  }
}
